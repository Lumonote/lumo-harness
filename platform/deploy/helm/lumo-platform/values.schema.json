{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ownedSessionConnectors": {
      "type": "array", "maxItems": 100, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["realm", "project_id", "connector_id", "operation"],
        "properties": {
          "realm": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "project_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "connector_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "operation": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
        }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "recoveryProvider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string" },
            "url": { "type": "string" },
            "operations": { "type": "array", "uniqueItems": true, "items": { "enum": ["restore", "key_destroy"] } },
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operation", "realm", "namespace", "prefix"],
                "properties": {
                  "operation": { "enum": ["restore", "key_destroy"] },
                  "realm": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                  "prefix": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }
                }
              }
            },
            "credentialsSecret": { "type": "string" },
            "tokenKey": { "type": "string", "minLength": 1 },
            "receiptKeyKey": { "type": "string", "minLength": 1 }
          },
          "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "then": {
            "required": ["id", "url", "operations", "scopes", "credentialsSecret", "tokenKey", "receiptKeyKey"],
            "properties": {
              "id": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "url": { "pattern": "^https?://[^\\s?#@]+$" },
              "operations": { "minItems": 1 },
              "scopes": { "minItems": 1 },
              "credentialsSecret": { "minLength": 1 }
            }
          }
        }
      }
    },
    "objectStore": {
      "type": "object",
      "properties": {
        "managedContent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageId": { "type": "string", "maxLength": 256 },
            "deleteEnabled": { "type": "boolean" },
            "retentionMs": { "type": "integer", "minimum": 0, "maximum": 315360000000 },
            "graceMs": { "type": "integer", "minimum": 0, "maximum": 315360000000 },
            "ioTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
            "gcIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 2147483647 }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "dshNode": {
      "type": "object",
      "properties": {
        "workloadKind": {
          "enum": [
            "Deployment",
            "StatefulSet"
          ]
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "spool": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "storageClass": {
                  "type": "string"
                }
              }
            }
          }
        },
        "hpa": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "externalMetrics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "averageValue"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "averageValue": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G)?$"
                  },
                  "matchLabels": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "threadExecution": {
          "$ref": "#/definitions/threadExecution"
        },
        "harness": {
          "$ref": "#/definitions/harness"
        }
      }
    },
    "dshWeb": {
      "type": "object",
      "properties": {
        "workloadKind": {
          "enum": [
            "Deployment",
            "StatefulSet"
          ]
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "spool": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string",
                  "minLength": 1
                },
                "storageClass": {
                  "type": "string"
                }
              }
            }
          }
        },
        "threadExecution": {
          "$ref": "#/definitions/threadExecution"
        },
        "userSessionExecution": {
          "$ref": "#/definitions/userSessionExecution"
        },
        "harness": {
          "$ref": "#/definitions/harness"
        }
      }
    },
    "availability": {
      "type": "object",
      "properties": {
        "topologySpread": {
          "type": "object",
          "properties": {
            "whenUnsatisfiable": {
              "enum": [
                "DoNotSchedule",
                "ScheduleAnyway"
              ]
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "externalEgress": {
          "type": "array"
        }
      }
    }
  },
  "definitions": {
    "threadExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distributed": {
          "const": true
        },
        "sessionControlUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "governanceUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "\\S"
        },
        "agentId": {
          "type": "string",
          "pattern": "\\S"
        },
        "presetRevision": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string",
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800000
        }
      },
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "distributed",
            "sessionControlUrl",
            "governanceUrl",
            "projectId",
            "agentId",
            "presetRevision",
            "provider",
            "model"
          ]
        }
      ]
    },
    "userSessionExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorityUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "\\S"
        },
        "projectId": {
          "type": "string",
          "pattern": "\\S"
        },
        "workspaceRoot": {
          "type": "string",
          "pattern": "^/"
        },
        "provider": {
          "type": "string",
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "modelChoices": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "label", "provider", "model", "billingModel"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
              "model": { "type": "string", "minLength": 1, "maxLength": 256 },
              "billingModel": { "type": "string", "minLength": 1, "maxLength": 256 },
              "reasoningEffort": { "type": "string", "minLength": 1, "maxLength": 64 }
            }
          }
        },
        "routing": {
          "type": "object", "additionalProperties": false,
          "required": ["routes", "transportSecurity"],
          "properties": {
            "nodeIdFromEnvironment": { "type": "boolean" },
            "transportSecurity": { "enum": ["tls", "mesh-mtls", "development"] },
            "routes": { "type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": { "type": "string", "pattern": "^https?://[^/\\s?#@]+/?$" } }
          }
        },
        "attachments": {
          "type": "object", "additionalProperties": false, "required": ["realm"],
          "properties": {
            "realm": { "type": "string", "pattern": "\\S" },
            "maxUploadBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
            "maxTextBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "maxPerMessage": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realm"],
          "properties": {
            "realm": { "type": "string", "pattern": "\\S" },
            "defaultTopK": { "type": "integer", "minimum": 1, "maximum": 10 },
            "spaces": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "\\S" } }
          }
        },
        "connectors": {
          "type": "object", "additionalProperties": false,
          "required": ["realm", "gatewayUrl", "actions"],
          "properties": {
            "realm": { "type": "string", "pattern": "\\S" },
            "gatewayUrl": { "type": "string", "pattern": "^https?://[^\\s?#@]+$" },
            "actions": {
              "type": "array", "minItems": 1, "maxItems": 50,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["connectorId", "operations"],
                "properties": {
                  "connectorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
                  "operations": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" } }
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "authorityUrl",
            "nodeId",
            "projectId",
            "workspaceRoot",
            "provider",
            "model"
          ]
        }
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patchConfigMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "maxLength": 253
        },
        "patchKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$",
          "maxLength": 253
        },
        "credentialsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "maxLength": 253
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
