{
  "name": "@lumo/dsh-platform-ui",
  "description": "Lumo platform surfaces mounted inside the native DeepSeek Harness Web shell",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/dsh-plugins/lumo-ui/src/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/dsh-plugins/lumo-ui/src/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/dsh-plugins/lumo-ui/src/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-theme"],
      "external": ["@deepseek-ai/dsh-client-ui-sidebar-documentpreview/client", "@deepseek-ai/dsh-client-ui-primitives"],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": { "bundle": "../../../deepseek-harness/node_modules/.bin/tsdown --config tsdown.config.ts" },
  "dependencies": {
    "execa": "^9.6.1",
    "@deepseek-ai/dsh-skill": "link:../../../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/dsh-skill-filesystem": "link:../../../deepseek-harness/packages/skill/skill-filesystem",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-atomic-write": "link:../../../deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-client-connection": "link:../../../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-credentials": "link:../../../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "link:../../../deepseek-harness/packages/client/ui-sidebar-documentpreview",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-theme": "link:../../../deepseek-harness/packages/client/ui-theme",
    "@deepseek-ai/dsh-host-webserver": "link:../../../deepseek-harness/packages/host/webserver",
    "@deepseek-ai/dsh-host-authentication-token": "link:../../../deepseek-harness/packages/host/authentication-token",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "react-dom": "link:../../../deepseek-harness/packages/client/ui-jobs/node_modules/react-dom",
    "react": "link:../../../deepseek-harness/packages/client/ui-jobs/node_modules/react"
  },
  "devDependencies": {
    "@types/node": "link:../../../deepseek-harness/node_modules/@types/node",
    "@types/react-dom": "link:../../../deepseek-harness/node_modules/@types/react-dom",
    "@types/react": "~18.3.1"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "cordis.patch.yml"]
}
