{
  "name": "@lumo/platform",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "dsh-plugins/*",
    "console"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "typecheck:client": "tsc -p dsh-plugins/lumo-ui/tsconfig.json --noEmit",
    "codegen:plugin-baseline": "node tools/gen-plugin-baseline.mjs",
    "check:plugin-baseline": "node tools/gen-plugin-baseline.mjs --check",
    "codegen:skillhub-seed": "node tools/gen-skillhub-seed.mjs",
    "check:skillhub-seed": "node tools/gen-skillhub-seed.mjs --check",
    "kb:eval": "tsx dsh-plugins/knowledge/eval/run-eval.ts",
    "skillhub": "node tools/skillhub-sync.mjs",
    "desktop:dev": "cd desktop && cargo tauri dev",
    "desktop:build": "cd desktop && cargo tauri build --bundles app",
    "desktop:dmg": "cd desktop && cargo tauri build --bundles app && bash make-dmg.sh",
    "desktop:win": "cd desktop && cargo tauri build --bundles nsis"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
