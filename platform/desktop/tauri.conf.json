{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "io.lumo.desktop",
  "build": {
    "beforeBuildCommand": {
      "script": "node before-build.mjs",
      "cwd": "."
    },
    "devUrl": "http://127.0.0.1:3080",
    "frontendDist": "../desktop-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:3080; connect-src 'self' http://127.0.0.1:3080 ws://127.0.0.1:3080; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Lumo.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "lumo-runtime": "runtime"
    }
  }
}
