# The upstream dsh build embeds its source commit. Keep only the metadata
# needed to resolve HEAD; never send the full Git history in the build context.
.git
**/.git/**
!deepseek-harness/.git/
!deepseek-harness/.git/HEAD
!deepseek-harness/.git/refs/
!deepseek-harness/.git/refs/heads/
!deepseek-harness/.git/refs/heads/**
!deepseek-harness/.git/packed-refs
.codegraph
**/node_modules
**/target
**/.cache
**/coverage
**/dist
**/.turbo
# Generated desktop/runtime staging trees are not inputs to image builds.
platform/.build
platform/desktop/lumo-runtime
# Runtime credentials belong to the mounted DSH home or deployment Secrets.
# Keep only explicitly named environment templates in the image build context.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
